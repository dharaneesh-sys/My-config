VSCODE_PALETTE="$PALETTE"
python3 -c "
import json, os, sys

# Read palette file (passed as argument)
palette_file = sys.argv[1] if len(sys.argv) > 1 else '$PALETTE'
palette = {}
with open(palette_file) as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if '=' in line:
            k, v = line.split('=', 1)
            palette[k.strip()] = v.strip()

def hex_stripped(key):
    return palette.get(key, '#000000').lstrip('#')

# Read current settings
settings_path = os.path.expanduser('$VSCODE_SETTINGS')
settings = {}
if os.path.exists(settings_path):
    try:
        with open(settings_path) as f:
            settings = json.load(f)
    except:
        pass

