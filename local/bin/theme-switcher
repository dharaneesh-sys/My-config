# Update Zed settings to use the new theme
settings_path = os.path.expanduser('$ZED_SETTINGS')
settings = {}
if os.path.exists(settings_path):
    try:
        with open(settings_path) as f:
            # Zed uses JSONC (JSON with comments + trailing commas).
            # Parse properly: strip comments (outside strings) then trailing commas.
            content = f.read()
            import re

            # Remove // line comments and /* block comments (not inside strings)
            result = []
            i = 0
            in_str = False
            str_char = None
            while i < len(content):
                c = content[i]
                if in_str:
                    result.append(c)
                    if c == '\\\\' and i + 1 < len(content):
                        result.append(content[i+1])
                        i += 2
                        continue
                    if c == str_char:
                        in_str = False
                else:
                    if c in ('\"', \"'\"):
                        in_str = True
                        str_char = c
                        result.append(c)
                    elif c == '/' and i + 1 < len(content) and content[i+1] == '/':
                        # // comment: skip to end of line
                        i += 2
                        while i < len(content) and content[i] != '\\n':
                            i += 1
                        result.append('\\n')
                        i += 1
                        continue
                    elif c == '/' and i + 1 < len(content) and content[i+1] == '*':
                        # /* comment */: skip to */
                        i += 2
                        while i + 1 < len(content) and not (content[i] == '*' and content[i+1] == '/'):
                            i += 1
                        i += 2  # skip */
                        continue
                    else:
                        result.append(c)
                i += 1
            content = ''.join(result)

            # Remove trailing commas before ] or }
            content = re.sub(r',\s*([\\]}])', r'\\1', content)

            settings = json.loads(content)
    except Exception as e:
        print(f'Zed: could not parse existing settings.json ({e}), creating fresh')
        settings = {}

settings['theme'] = {
    'mode': 'dark',
    'light': settings.get('theme', {}).get('light', 'One Light') if isinstance(settings.get('theme'), dict) else 'One Light',
    'dark': 'Ariadne',
}

with open(settings_path, 'w') as f:
    json.dump(settings, f, indent=2)

print(f'Zed: wrote theme \"Ariadne\" → {theme_path} (set in settings.json)')
"

