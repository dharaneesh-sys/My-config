#!/usr/bin/env bash
set -euo pipefail

THEMES_DIR="$HOME/.config/hypr/themes"
CACHE_DIR="$HOME/.cache/wallpaper"
CURRENT_THEME_FILE="$CACHE_DIR/current_theme"
LAST_WALLPAPER="$CACHE_DIR/last_wallpaper"

mkdir -p "$CACHE_DIR"

# ---- discover themes ----
mapfile -t THEMES < <(find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
if [[ ${#THEMES[@]} -eq 0 ]]; then
  notify-send "Theme Switcher" "No themes found in $THEMES_DIR"
  exit 1
fi

# ---- get current theme ----
CURRENT=""
[[ -f "$CURRENT_THEME_FILE" ]] && CURRENT=$(<"$CURRENT_THEME_FILE")

# ---- accept theme name from argument (GUI from Quickshell) ----
SELECTED="${1:-}"
if [[ -z "$SELECTED" ]]; then
  notify-send "Theme Switcher" "Usage: theme-switcher <theme-name>\nUse the bar → Theme button to pick interactively."
  exit 1
fi

# Validate theme exists
VALID=false
for t in "${THEMES[@]}"; do
  if [[ "$t" == "$SELECTED" ]]; then
    VALID=true
    break
  fi
done
if ! $VALID; then
  notify-send "Theme Switcher" "Theme '$SELECTED' not found in $THEMES_DIR"
  exit 1
fi

THEME_DIR="$THEMES_DIR/$SELECTED"
PALETTE="$THEME_DIR/palette"
WP_DIR="$HOME/Pictures/Themes/$SELECTED"

# ---- Dynamic: regenerate palette from current wallpaper ----
if [[ "$SELECTED" == "Dynamic" ]]; then
  mkdir -p "$WP_DIR"
  LAST_WALL=$(cat "$LAST_WALLPAPER" 2>/dev/null || echo "")
  if [[ -n "$LAST_WALL" && -f "$LAST_WALL" ]]; then
    matugen image "$LAST_WALL" --json hex --source-color-index 0 2>/dev/null | python3 -c "
import json, sys
data = json.load(sys.stdin)
colors = data.get('colors', {})
def get_color(name, fallback):
    entry = colors.get(name)
    if entry and isinstance(entry, dict):
        variant = entry.get('default') or entry.get('dark') or {}
        return variant.get('color', fallback)
    return fallback

header = '# M3 Color Palette: Dynamic (auto-generated from wallpaper)'
print(header)

core_tones = {
    'primary': '#a7c080', 'on_primary': '#2d353b', 'primary_container': '#3d484d',
    'on_primary_container': '#a7c080', 'secondary': '#d3c6aa', 'on_secondary': '#2d353b',
    'tertiary': '#7fbbb3', 'surface': '#2d353b', 'on_surface': '#d3c6aa',
    'error': '#e67e80', 'outline': '#5f6c71',
    'on_tertiary': '#2d353b', 'on_error': '#2d353b',
    'surface_variant': '#3d484d',
}
for name, fallback in core_tones.items():
    print(f'{name}={get_color(name, fallback)}')

extended = [
    'primary_fixed', 'primary_fixed_dim', 'on_primary_fixed', 'on_primary_fixed_variant',
    'secondary_fixed', 'secondary_fixed_dim', 'on_secondary_fixed', 'on_secondary_fixed_variant',
    'tertiary_fixed', 'tertiary_fixed_dim', 'on_tertiary_fixed', 'on_tertiary_fixed_variant',
    'secondary_container', 'on_secondary_container',
    'tertiary_container', 'on_tertiary_container',
    'error_container', 'on_error_container',
    'surface_dim', 'surface_bright', 'surface_container_lowest',
    'surface_container_low', 'surface_container', 'surface_container_high', 'surface_container_highest',
    'on_surface_variant', 'inverse_surface', 'inverse_on_surface',
    'inverse_primary', 'outline_variant', 'scrim', 'shadow', 'source_color',
]
for tone in extended:
    print(f'{tone}={get_color(tone, \"#000000\")}')
" > "$PALETTE"
  fi
fi

# ---- validate ----
if [[ ! -f "$PALETTE" ]]; then
  notify-send "Theme Switcher" "No palette found for $SELECTED"
  exit 1
fi
if [[ ! -d "$WP_DIR" ]]; then
  notify-send "Theme Switcher" "No wallpaper directory for $SELECTED"
  exit 1
fi

# ---- source palette ----
declare -A COLORS
while IFS='=' read -r key value; do
  [[ -z "$key" || "$key" == \#* ]] && continue
  COLORS["$key"]="$value"
done <"$PALETTE"

hex() { echo "${COLORS[$1]}"; }
hex_stripped() { echo "${COLORS[$1]#\#}"; }
rgb() {
  local h="${1#\#}"
  printf "%d,%d,%d" 0x${h:0:2} 0x${h:2:2} 0x${h:4:2}
}

# ==============================================================
# Generate output files
# ==============================================================

# 1. Hyprland colors.conf
{
  echo "# Theme: $SELECTED"
  for key in "${!COLORS[@]}"; do echo "\$$key = rgba($(hex_stripped "$key")ff)"; done
} >"$HOME/.config/hypr/colors.conf"

# 2. Waybar / SwayNC / Wlogout colors.css
{
  echo "/* Theme: $SELECTED */"
  for key in "${!COLORS[@]}"; do echo "@define-color $key $(hex "$key");"; done
} >"$HOME/.config/waybar/colors.css"
cp "$HOME/.config/waybar/colors.css" "$HOME/.config/swaync/colors.css"
cp "$HOME/.config/waybar/colors.css" "$HOME/.config/wlogout/colors.css"

# 3. Rofi colors.rasi — all palette keys, underscores → hyphens
{
  echo "* {"
  for key in "${!COLORS[@]}"; do
    echo "    ${key//_/-}: $(hex "$key");"
  done
  echo "}"
} >"$HOME/.config/rofi/colors.rasi"

# 4. GTK3 & GTK4 — theme colors
GTK_COLORS=$(
  cat <<COLORS_EOF
@define-color accent_color $(hex primary);
@define-color accent_fg_color $(hex on_primary);
@define-color accent_bg_color $(hex primary);
@define-color destructive_color $(hex error);
@define-color destructive_fg_color $(hex on_error);
@define-color destructive_bg_color $(hex error);
@define-color success_color $(hex primary);
@define-color success_fg_color $(hex on_primary);
@define-color success_bg_color $(hex primary);
@define-color warning_color $(hex tertiary);
@define-color warning_fg_color $(hex on_tertiary);
@define-color warning_bg_color $(hex tertiary);
@define-color error_color $(hex error);
@define-color error_fg_color $(hex on_error);
@define-color error_bg_color $(hex error);
@define-color window_bg_color $(hex surface_container_lowest);
@define-color window_fg_color $(hex on_surface);
@define-color view_bg_color $(hex surface);
@define-color view_fg_color $(hex on_surface);
@define-color headerbar_bg_color $(hex surface_container);
@define-color headerbar_fg_color $(hex on_surface);
@define-color headerbar_backdrop_color $(hex surface_dim);
@define-color card_bg_color $(hex surface_container_high);
@define-color card_fg_color $(hex on_surface);
@define-color popover_bg_color $(hex surface_container_high);
@define-color popover_fg_color $(hex on_surface);
@define-color sidebar_bg_color $(hex surface_dim);
@define-color sidebar_fg_color $(hex on_surface);
@define-color sidebar_backdrop_color $(hex surface_dim);
@define-color dialog_bg_color $(hex surface_container_high);
@define-color dialog_fg_color $(hex on_surface);
@define-color titlebar_bg_color $(hex surface_container);
@define-color titlebar_fg_color $(hex on_surface);
@define-color titlebar_backdrop_color $(hex surface_dim);
@define-color tooltip_bg_color $(hex surface_container_highest);
@define-color tooltip_fg_color $(hex on_surface);
@define-color menu_bg_color $(hex surface_container);
@define-color menu_fg_color $(hex on_surface);
@define-color scrollbar_bg_color $(hex surface);
@define-color scrollbar_slider_color $(hex primary);
@define-color theme_bg_color $(hex surface_dim);
@define-color theme_fg_color $(hex on_surface);
@define-color theme_base_color $(hex surface);
@define-color theme_text_color $(hex on_surface);
@define-color theme_selected_bg_color $(hex primary);
@define-color theme_selected_fg_color $(hex on_primary);
@define-color theme_unfocused_bg_color $(hex surface_dim);
@define-color theme_unfocused_fg_color $(hex on_surface);
@define-color theme_unfocused_base_color $(hex surface);
@define-color theme_unfocused_selected_bg_color $(hex primary);
@define-color theme_unfocused_selected_fg_color $(hex on_primary);
COLORS_EOF
)

printf '%s\n' "$GTK_COLORS" >"$HOME/.config/gtk-3.0/gtk.css"
cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-3.0/colors.css"
cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/gtk-dark.css"
cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/colors.css"

# 5. Custom theme for GTK3 live reload and GTK4 portal support (adw-gtk3-dank)
CUSTOM_THEME_DIR="$HOME/.local/share/themes/adw-gtk3-dank"
mkdir -p "$CUSTOM_THEME_DIR/gtk-3.0/assets"
cp -r /usr/share/themes/adw-gtk3-dark/gtk-3.0/assets/* "$CUSTOM_THEME_DIR/gtk-3.0/assets/"
cp /usr/share/themes/adw-gtk3-dark/gtk-3.0/gtk.css "$CUSTOM_THEME_DIR/gtk-3.0/gtk.css"
cp /usr/share/themes/adw-gtk3-dark/gtk-3.0/gtk-dark.css "$CUSTOM_THEME_DIR/gtk-3.0/gtk-dark.css"
cp /usr/share/themes/adw-gtk3-dark/gtk-3.0/thumbnail.png "$CUSTOM_THEME_DIR/gtk-3.0/" 2>/dev/null || true

# --- GTK4 / libadwaita: copy CSS so file chooser dialogs and other GTK4 portal windows pick up our colors ---
mkdir -p "$CUSTOM_THEME_DIR/gtk-4.0"
for f in gtk.css gtk-dark.css libadwaita.css libadwaita-tweaks.css; do
  cp "/usr/share/themes/adw-gtk3-dark/gtk-4.0/$f" "$CUSTOM_THEME_DIR/gtk-4.0/$f"
done

cat >"$CUSTOM_THEME_DIR/index.theme" <<EOF
[X-GNOME-Metatheme]
Name=adw-gtk3-dank
Type=X-GNOME-Metatheme
Comment=adw-gtk3-dank
Encoding=UTF-8
GtkTheme=adw-gtk3-dank
EOF

# Append our colors — CSS cascade means last @define-color wins, no need to sed-patch
for css in \
  "$CUSTOM_THEME_DIR/gtk-3.0/gtk.css" \
  "$CUSTOM_THEME_DIR/gtk-3.0/gtk-dark.css" \
  "$CUSTOM_THEME_DIR/gtk-4.0/gtk.css" \
  "$CUSTOM_THEME_DIR/gtk-4.0/gtk-dark.css"; do
  printf '\n%s\n' "$GTK_COLORS" >> "$css"
done

# 6. Ghostty — full terminal palette
{
  echo "# Theme: $SELECTED — Generated by theme-switcher"
  echo ""
  echo "background = 000000"
  echo "foreground = $(hex on_surface)"
  echo "cursor-color = $(hex on_surface)"
  echo "cursor-text = $(hex surface)"
  echo "selection-background = $(hex secondary_fixed_dim)"
  echo "selection-foreground = $(hex on_secondary)"
  echo ""
  echo "# ANSI 16-color palette mapped to M3 theme colors"
  echo "palette = 0=$(hex surface_container_lowest)"
  echo "palette = 1=$(hex error)"
  echo "palette = 2=$(hex tertiary)"
  echo "palette = 3=$(hex primary_fixed)"
  echo "palette = 4=$(hex primary)"
  echo "palette = 5=$(hex secondary)"
  echo "palette = 6=$(hex tertiary_fixed_dim)"
  echo "palette = 7=$(hex on_surface)"
  echo "palette = 8=$(hex surface_container)"
  echo "palette = 9=$(hex error_container)"
  echo "palette = 10=$(hex tertiary_container)"
  echo "palette = 11=$(hex primary_fixed_dim)"
  echo "palette = 12=$(hex inverse_primary)"
  echo "palette = 13=$(hex secondary_fixed)"
  echo "palette = 14=$(hex on_tertiary_container)"
  echo "palette = 15=$(hex surface_bright)"
} >"$HOME/.config/ghostty/themes/Matugen"

# 7. Neovim
mkdir -p "$HOME/.config/nvim/lua"
{
  echo "-- Generated by theme-switcher - Theme: $SELECTED"
  echo "return {"
  for key in "${!COLORS[@]}"; do
    printf "  ['%s'] = '#%s',\n" "$key" "$(hex_stripped "$key")"
  done
  echo "}"
} >"$HOME/.config/nvim/lua/theme-colors.lua"

# (Yazi — no custom theme, uses built-in default)

# 8. Zsh — theme color variables
mkdir -p "$HOME/.config/zsh"
{
  echo "# Theme: $SELECTED — Generated by theme-switcher"
  for key in "${!COLORS[@]}"; do
    printf "export COLOR_%s='%s'\n" "${key^^}" "$(hex "$key")"
  done
} >"$HOME/.config/zsh/theme-colors.zsh"

# Append LS_COLORS using theme colors (24-bit ANSI)
{
  echo ""
  echo "# LS_COLORS from theme colors"
  echo "LS_COLORS=\"\""

  # Helper: hex → 38;2;R;G;B
  _a() { rgb "$1" | tr ',' ';'; }

  # Core types
  echo "LS_COLORS=\"\${LS_COLORS}di=38;2;$(_a "$(hex primary)"):\""     # directory  = primary
  echo "LS_COLORS=\"\${LS_COLORS}ln=38;2;$(_a "$(hex tertiary)"):\""    # symlink    = tertiary
  echo "LS_COLORS=\"\${LS_COLORS}ex=38;2;$(_a "$(hex secondary)"):\""   # executable = secondary
  echo "LS_COLORS=\"\${LS_COLORS}or=38;2;$(_a "$(hex error)"):\""       # orphan     = error
  echo "LS_COLORS=\"\${LS_COLORS}rs=0:\""
  echo "LS_COLORS=\"\${LS_COLORS}fi=0:\""

  # Archives = secondary
  for ext in tar tgz gz bz2 xz zip 7z rar zst; do
    echo "LS_COLORS=\"\${LS_COLORS}*.${ext}=38;2;$(_a "$(hex secondary)"):\""
  done

  # Images = tertiary
  for ext in png jpg jpeg webp gif bmp avif svg; do
    echo "LS_COLORS=\"\${LS_COLORS}*.${ext}=38;2;$(_a "$(hex tertiary)"):\""
  done

  # Media = tertiary
  for ext in mp3 mp4 flac ogg mkv webm avi mov wav; do
    echo "LS_COLORS=\"\${LS_COLORS}*.${ext}=38;2;$(_a "$(hex tertiary)"):\""
  done

  # Documents = primary
  for ext in pdf doc docx odt ods xls xlsx ppt pptx txt; do
    echo "LS_COLORS=\"\${LS_COLORS}*.${ext}=38;2;$(_a "$(hex primary)"):\""
  done

  # Code = secondary
  for ext in py js ts rs go c cpp h java rb sh bash zsh lua; do
    echo "LS_COLORS=\"\${LS_COLORS}*.${ext}=38;2;$(_a "$(hex secondary)"):\""
  done

  echo "export LS_COLORS"
} >> "$HOME/.config/zsh/theme-colors.zsh"

# 9. Starship — clean modern prompt with theme colors
{
  echo "# Starship config — Generated by theme-switcher for theme: $SELECTED"
  echo ""
  cat <<STARSHIP
format = """\
\$directory\
\$git_branch\
\$git_status\
\$fill\
\$cmd_duration\
\$line_break\
\$character\
"""

[directory]
truncation_length = 3
truncate_to_repo = false
format = "[ \$path](bold fg:$(hex primary))"

[git_branch]
format = "[  \$branch](fg:$(hex on_surface_variant))"
truncation_length = 10

[git_status]
conflicted = ""
untracked = ""
stashed = ""
modified = ""
staged = ""
renamed = ""
deleted = ""
ahead = ""
behind = ""
diverged = ""
format = "[*](fg:$(hex error))"

[character]
success_symbol = "[❯](bold fg:$(hex primary))"
error_symbol = "[✗](bold fg:$(hex error))"
vimcmd_symbol = "[❮](bold fg:$(hex secondary))"

[cmd_duration]
min_time = 2000
format = "[⏱ \$duration](fg:$(hex tertiary))"

[fill]
symbol = " "
STARSHIP
} > "$HOME/.config/starship.toml"

: <<'__SKIP_QT__'
# 10. KDE / Qt color scheme
KDE_SCHEME_NAME="Matugen-$SELECTED"
{
  sec() {
    local bg="$1" bgalt="$2"
    cat <<SEC
BackgroundAlternate=$(rgb "$bgalt")
BackgroundNormal=$(rgb "$bg")
DecorationFocus=$(rgb "$(hex primary)")
DecorationHover=$(rgb "$(hex primary)")
ForegroundActive=$(rgb "$(hex primary)")
ForegroundInactive=$(rgb "$(hex on_surface_variant)")
ForegroundLink=$(rgb "$(hex primary)")
ForegroundNegative=$(rgb "$(hex error)")
ForegroundNeutral=$(rgb "$(hex tertiary)")
ForegroundNormal=$(rgb "$(hex on_surface)")
ForegroundPositive=$(rgb "$(hex primary)")
ForegroundVisited=$(rgb "$(hex secondary)")
SEC
  }
  echo "# Generated by theme-switcher - Theme: $SELECTED"
  echo ""
  echo "[ColorEffects:Disabled]"
  echo "Color=56,56,56"
  echo "ColorAmount=0"
  echo "ColorEffect=0"
  echo "ContrastAmount=0.65"
  echo "ContrastEffect=1"
  echo "IntensityAmount=0.1"
  echo "IntensityEffect=2"
  echo ""
  echo "[ColorEffects:Inactive]"
  echo "ChangeSelectionColor=true"
  echo "Color=112,111,110"
  echo "ColorAmount=0.025"
  echo "ColorEffect=2"
  echo "ContrastAmount=0.1"
  echo "ContrastEffect=2"
  echo "Enable=false"
  echo "IntensityAmount=0"
  echo "IntensityEffect=0"
  echo ""
  echo "[Colors:Button]"
  sec "$(hex surface_container)" "$(hex surface_container_high)"
  echo ""
  echo "[Colors:Complementary]"
  sec "$(hex surface_container_low)" "$(hex surface_container)"
  echo ""
  echo "[Colors:Header]"
  sec "$(hex surface_container)" "$(hex surface_dim)"
  echo ""
  echo "[Colors:Selection]"
  echo "BackgroundAlternate=$(rgb "$(hex primary_container)")"
  echo "BackgroundNormal=$(rgb "$(hex primary)")"
  echo "DecorationFocus=$(rgb "$(hex primary)")"
  echo "DecorationHover=$(rgb "$(hex primary)")"
  echo "ForegroundActive=$(rgb "$(hex on_primary)")"
  echo "ForegroundInactive=$(rgb "$(hex on_surface_variant)")"
  echo "ForegroundLink=$(rgb "$(hex primary_fixed)")"
  echo "ForegroundNegative=$(rgb "$(hex on_error)")"
  echo "ForegroundNeutral=$(rgb "$(hex on_tertiary)")"
  echo "ForegroundNormal=$(rgb "$(hex on_primary)")"
  echo "ForegroundPositive=$(rgb "$(hex on_primary_fixed)")"
  echo "ForegroundVisited=$(rgb "$(hex secondary_fixed)")"
  echo ""
  echo "[Colors:Tooltip]"
  sec "$(hex surface_container_highest)" "$(hex surface_container_high)"
  echo ""
  echo "[Colors:View]"
  sec "$(hex surface)" "$(hex surface_container_low)"
  echo ""
  echo "[Colors:Window]"
  sec "$(hex surface_dim)" "$(hex surface_container)"
  echo ""
  echo "[General]"
  echo "ColorScheme=$KDE_SCHEME_NAME"
  echo "Name=$KDE_SCHEME_NAME"
  echo "shadeSortColumn=true"
  echo ""
  echo "[KDE]"
  echo "contrast=4"
  echo ""
  echo "[WM]"
  echo "activeBackground=$(rgb "$(hex surface_container)")"
  echo "activeBlend=$(rgb "$(hex primary)")"
  echo "activeForeground=$(rgb "$(hex on_surface)")"
  echo "inactiveBackground=$(rgb "$(hex surface_dim)")"
  echo "inactiveBlend=$(rgb "$(hex on_surface_variant)")"
  echo "inactiveForeground=$(rgb "$(hex on_surface_variant)")"
} >"$HOME/.local/share/color-schemes/$KDE_SCHEME_NAME.colors"

# Write color sections directly to kdeglobals (works on Hyprland without Plasma)
# This ensures Dolphin and other KDE/Qt apps pick up the theme colors immediately.
python3 -c "
import configparser, os, sys

scheme_path = os.path.expanduser('$HOME/.local/share/color-schemes/$KDE_SCHEME_NAME.colors')
globals_path = os.path.expanduser('$HOME/.config/kdeglobals')

# Read the fresh KDE scheme
scheme = configparser.ConfigParser()
scheme.read(scheme_path)

# Read existing kdeglobals (preserve non-color sections)
globals = configparser.ConfigParser()
globals.read(globals_path)

# Overwrite only color sections from the scheme
color_sections = ['ColorEffects:Disabled', 'ColorEffects:Inactive',
                  'Colors:Button', 'Colors:Complementary', 'Colors:Header',
                  'Colors:Selection', 'Colors:Tooltip', 'Colors:View',
                  'Colors:Window']

for section in color_sections:
    if scheme.has_section(section):
        if globals.has_section(section):
            globals.remove_section(section)
        globals.add_section(section)
        for key, val in scheme.items(section):
            globals.set(section, key, val)

# Update General section with scheme name and accent colors
if globals.has_section('General'):
    globals.set('General', 'ColorScheme', '$KDE_SCHEME_NAME')
    globals.set('General', 'AccentColor', '$(rgb "$(hex primary)")')
    globals.set('General', 'LastUsedCustomAccentColor', '$(rgb "$(hex primary)")')

# Write back
with open(globals_path, 'w') as f:
    globals.write(f)

print(f'kdeglobals: updated with {scheme_path}')
"

# Clear per-app ColorScheme overrides so apps follow system theme
for rc in okularrc okularpartrc; do
  f="$HOME/.config/$rc"
  [[ -f "$f" ]] && sed -i '/^ColorScheme=/d' "$f"
done

# 11. Qt6ct color scheme (for QT_QPA_PLATFORMTHEME=qt6ct)
qt6ct_dir="$HOME/.config/qt6ct/colors"
mkdir -p "$qt6ct_dir"
{
  echo "[ColorScheme]"
  echo "active_colors=$(printf '#ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s' \
    "$(hex_stripped surface)" "$(hex_stripped on_surface)" "$(hex_stripped surface_container)" "$(hex_stripped surface_bright)" \
    "$(hex_stripped surface_container_lowest)" "$(hex_stripped outline)" "$(hex_stripped on_surface)" "$(hex_stripped on_surface)" \
    "$(hex_stripped on_surface)" "$(hex_stripped surface)" "$(hex_stripped surface_container_low)" "$(hex_stripped surface_container_highest)" \
    "$(hex_stripped on_surface)" "$(hex_stripped primary)" "$(hex_stripped on_primary)" "$(hex_stripped primary)" \
    "$(hex_stripped secondary)" "$(hex_stripped on_surface_variant)" "$(hex_stripped scrim)" "$(hex_stripped on_surface_variant)" \
    "$(hex_stripped primary)")"
  echo "disabled_colors=$(printf '#ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s' \
    "$(hex_stripped surface)" "$(hex_stripped outline)" "$(hex_stripped surface_container)" "$(hex_stripped surface_bright)" \
    "$(hex_stripped surface_container_lowest)" "$(hex_stripped outline)" "$(hex_stripped outline)" "$(hex_stripped outline)" \
    "$(hex_stripped outline)" "$(hex_stripped surface)" "$(hex_stripped surface_container_low)" "$(hex_stripped surface_container_highest)" \
    "$(hex_stripped outline)" "$(hex_stripped surface_container_high)" "$(hex_stripped surface)" "$(hex_stripped outline)" \
    "$(hex_stripped outline)" "$(hex_stripped outline)" "$(hex_stripped scrim)" "$(hex_stripped outline)" \
    "$(hex_stripped surface_container_high)")"
  echo "inactive_colors=$(printf '#ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s, #ff%s' \
    "$(hex_stripped surface)" "$(hex_stripped on_surface)" "$(hex_stripped surface_container)" "$(hex_stripped surface_bright)" \
    "$(hex_stripped surface_container_lowest)" "$(hex_stripped outline)" "$(hex_stripped on_surface)" "$(hex_stripped on_surface)" \
    "$(hex_stripped on_surface)" "$(hex_stripped surface)" "$(hex_stripped surface_container_low)" "$(hex_stripped surface_container_highest)" \
    "$(hex_stripped on_surface)" "$(hex_stripped primary)" "$(hex_stripped on_primary)" "$(hex_stripped primary)" \
    "$(hex_stripped secondary)" "$(hex_stripped on_surface_variant)" "$(hex_stripped scrim)" "$(hex_stripped on_surface_variant)" \
    "$(hex_stripped primary)")"
} >"$qt6ct_dir/$SELECTED.conf"
# Update qt6ct config to use this scheme
QT6CT_CONF="$HOME/.config/qt6ct/qt6ct.conf"
python3 -c "
import configparser, os

conf_path = os.path.expanduser('$QT6CT_CONF')
config = configparser.ConfigParser()
config.read(conf_path)

if not config.has_section('Appearance'):
    config.add_section('Appearance')

config.set('Appearance', 'style', 'Fusion')
config.set('Appearance', 'custom_palette', 'true')
config.set('Appearance', 'color_scheme_path', '$qt6ct_dir/$SELECTED.conf')

# Preserve existing icon_theme if set, otherwise default to Papirus-Dark
if not config.has_option('Appearance', 'icon_theme'):
    config.set('Appearance', 'icon_theme', 'Papirus-Dark')

with open(conf_path, 'w') as f:
    config.write(f)

print(f'qt6ct.conf: appearance section updated (style=Fusion, scheme=$SELECTED)')
"
