# --- generate placeholder icons (16px, 48px, 128px) if missing ---
if [ ! -f "$BRAVE_THEME_DIR/images/icon128.png" ]; then
  python3 -c "
import zlib, struct

def make_png(w, h):
    raw = b'\x00' * (w * h * 4)
    def chunk(ctype, data):
        c = ctype + data
        return struct.pack('>I', len(data)) + c + struct.pack('>I', zlib.crc32(c) & 0xffffffff)
    ihdr = struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0)
    return b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', ihdr) + chunk(b'IDAT', zlib.compress(raw)) + chunk(b'IEND', b'')

for size in (16, 48, 128):
    with open('$BRAVE_THEME_DIR/images/icon{}.png'.format(size), 'wb') as f:
        f.write(make_png(size, size))
print('icons: placeholder PNGs created')
"
fi

BRAVE_VERSION="1.$(date +%Y%m%d.%H%M)"
python3 -c "
import json

palette = {}
with open('$PALETTE') as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        palette[k.strip()] = v.strip()

def h(key):
    return palette.get(key, '#000000')

def rgb(hex_color):
    c = hex_color.lstrip('#')
    return [int(c[i:i+2], 16) for i in (0, 2, 4)]

SURFACE       = rgb(h('surface'))
SURFACE_DIM   = rgb(h('surface_dim'))
