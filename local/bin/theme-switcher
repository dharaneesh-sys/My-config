import json
palette = {}
with open('$PALETTE') as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        palette[k.strip()] = v.strip()
with open('$RICELIN_DIR/theme-colors.json', 'w') as f:
    json.dump(palette, f, indent=2)
"

# 14. VSCodium — use workbench.colorCustomizations for instant hot-reload
# VS Code hot-reloads settings.json changes immediately (no restart needed)
