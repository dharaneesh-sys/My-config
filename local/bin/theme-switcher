# 17. herdr — agent terminal multiplexer. herdr has no config-include, so we
# splice the M3 palette into [theme.custom] + ui.accent in config.toml in
# place, preserving the user's manual keys (terminal, keys, ui, session…).
HERDR_CONFIG="$HOME/.config/herdr/config.toml"
mkdir -p "$(dirname "$HERDR_CONFIG")"
python3 - "$PALETTE" "$HERDR_CONFIG" <<'PYEOF'
import sys, os

palette_file, config_path = sys.argv[1], sys.argv[2]

palette = {}
with open(palette_file) as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if '=' in line:
            k, v = line.split('=', 1)
            palette[k.strip()] = v.strip()

def h(key):
    return palette.get(key, '#ffffff').lstrip('#')

# M3 palette -> herdr [theme.custom] tokens (mirrors the script's VSCode/terminal mapping)
tokens = [
    ('accent',      h('primary')),
    ('panel_bg',    h('surface')),
    ('surface0',    h('surface_container')),
    ('surface1',    h('surface_container_high')),
    ('surface_dim', h('surface_dim')),
    ('overlay0',    h('outline_variant')),
    ('overlay1',    h('outline')),
    ('text',        h('on_surface')),
    ('subtext0',    h('on_surface_variant')),
    ('mauve',       h('secondary')),
    ('green',       h('tertiary')),
    ('yellow',      h('primary_fixed')),
    ('red',         h('error')),
    ('blue',        h('primary_fixed_dim')),
    ('teal',        h('tertiary_fixed_dim')),
    ('peach',       h('secondary_fixed')),
]
accent = h('primary')

def theme_block():
    out = [
        '[theme]',
        '# Theme section — regenerated by theme-switcher on every theme change.',
        'name = "tokyo-night"',
        'auto_switch = false',
        '',
        '[theme.custom]',
        '# M3 palette -> herdr tokens (generated)',
    ]
    for k, v in tokens:
        if k == 'panel_bg':
            # User preference: keep the status bar / tab bar transparent
            # (reset = terminal background) instead of a solid surface color.
            out.append(f'{k} = "reset"')
            continue
        out.append(f'{k} = "#{v}"')
    return out

if not os.path.exists(config_path):
    # First run: minimal theme-only config; herdr uses defaults for the rest.
    with open(config_path, 'w') as f:
        f.write('# Generated by theme-switcher — herdr picked up the current theme.\n')
        f.write('\n'.join(theme_block()) + '\n')
    print(f'herdr: created {config_path}')
    sys.exit(0)

with open(config_path) as f:
    lines = f.readlines()

out = []
i = 0
n = len(lines)
theme_done = False
ui_accent_done = False

while i < n:
    line = lines[i]
    stripped = line.strip()

    if not theme_done and (stripped == '[theme]' or stripped.startswith('[theme.')):
        # Consume the existing theme block ([theme] + [theme.custom]) up to the
        # next unrelated section header, then emit the regenerated block.
        i += 1
        while i < n:
            s = lines[i].strip()
            if s.startswith('[') and not s.startswith('[theme'):
                break
            i += 1
        out.append('\n'.join(theme_block()) + '\n\n')
        theme_done = True
        continue

    if not theme_done and stripped == '[terminal]':
        # No [theme] block existed; insert ours right before the next section.
        out.append('\n'.join(theme_block()) + '\n\n')
        theme_done = True

    if stripped == '[ui]':
        out.append(line)
        i += 1
        saw_accent = False
        while i < n:
            s = lines[i].strip()
            if s.startswith('['):
                break
            if s.startswith('accent') and '=' in s:
                out.append(f'accent = "#{accent}"\n')
                ui_accent_done = True
                saw_accent = True
                i += 1
                continue
            out.append(lines[i])
            i += 1
        if not saw_accent:
            out.append(f'accent = "#{accent}"\n')
            ui_accent_done = True
        continue

    out.append(line)
    i += 1

if not theme_done:
    out.append('\n' + '\n'.join(theme_block()) + '\n')
if not ui_accent_done:
    out.append('\n[ui]\naccent = "#%s"\n' % accent)

with open(config_path, 'w') as f:
    f.writelines(out)
print(f'herdr: config theme updated (accent #{accent})')
PYEOF

# Live-reload herdr config if the server is running. Guard with a hard
# timeout so an unresponsive/unreachable herdr server can never block the
# theme switch — on failure we just fall through.
if timeout 5 herdr server reload-config >/dev/null 2>&1; then
  echo "herdr: config reloaded"
else
  echo "herdr: config written (server not running — applies on next launch)"
fi

# ==============================================================
# Pick random wallpaper and apply
# ==============================================================
if [[ "$SELECTED" == "Dynamic" ]]; then
  # Dynamic: keep current wallpaper, just change colors
  if [[ ! -f "$LAST_WALLPAPER" ]]; then
    notify-send "Theme Switcher" "No wallpaper has been set yet. Set one first."
    exit 1
  fi
  RANDOM_WP=$(<"$LAST_WALLPAPER")
else
  mapfile -t WALLPAPERS < <(find "$WP_DIR" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.avif' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.tiff' -o -iname '*.tif' -o -iname '*.svg' \) | sort)
  if [[ ${#WALLPAPERS[@]} -eq 0 ]]; then
    notify-send "Theme Switcher" "No wallpapers found in $WP_DIR"
    exit 1
  fi
  RANDOM_WP="${WALLPAPERS[RANDOM % ${#WALLPAPERS[@]}]}"
fi

echo "$SELECTED" >"$CURRENT_THEME_FILE"
echo "$RANDOM_WP" >"$LAST_WALLPAPER"

# Update matuwall wallpaper_dir to match current theme
MATUWALL_CONFIG="$HOME/.config/matuwall/config.json"
if [[ -f "$MATUWALL_CONFIG" ]] && command -v jq >/dev/null; then
  jq --arg dir "$WP_DIR" '.main.wallpaper_dir = $dir' "$MATUWALL_CONFIG" >"$MATUWALL_CONFIG.tmp" && mv "$MATUWALL_CONFIG.tmp" "$MATUWALL_CONFIG"
fi

pgrep -x awww-daemon >/dev/null || awww-daemon &
sleep 0.3

notify-send -i "$RANDOM_WP" "Theme Switcher" "Switching to $SELECTED…"

TRANSITION_DURATION=2.5
awww img \
  --transition-type random \
  --transition-duration "$TRANSITION_DURATION" \
  --transition-step 15 \
  --transition-fps 60 \
  "$RANDOM_WP"

sleep "$TRANSITION_DURATION"

# ==============================================================
# Post-hooks
# ==============================================================
hyprctl reload 2>/dev/null || true
sleep 0.2
pkill -SIGUSR2 waybar 2>/dev/null || true
sleep 0.2
pkill -SIGUSR2 ghostty 2>/dev/null || true
# SwayNC — write slider-override.css with hardcoded hex values to
# bypass GTK's @define-color caching bug, then full restart to
# clear GTK widget style cache.
SWAYNC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/swaync"
cat > "$SWAYNC_DIR/slider-override.css" <<SWAYNC_OVERRIDE
/* slider-override.css — GENERATED by theme-switcher
   Hardcoded hex values bypass GTK's @define-color caching
   bug that prevents slider/scale widget colors from updating. */

/* Volume & Backlight scale highlight */
.widget-volume highlight,
.widget-backlight highlight,
widget-volume highlight,
widget-backlight highlight {
    background: $(hex primary) !important;
    border-radius: 10px;
}
scale highlight {
    background: $(hex primary) !important;
    border-radius: 10px;
}
scale highlight background {
    background: $(hex primary) !important;
}

/* Volume & Backlight trough */
.widget-volume trough,
.widget-backlight trough,
widget-volume trough,
widget-backlight trough {
    background: $(hex surface) !important;
    border-radius: 10px;
}
scale trough,
scale trough background {
    background: $(hex surface) !important;
    border-radius: 10px;
}

/* Volume & Backlight slider knob */
.widget-volume slider,
.widget-backlight slider,
widget-volume slider,
widget-backlight slider {
    background: $(hex on_surface) !important;
    border: 2px solid $(hex primary) !important;
    border-radius: 50%;
    box-shadow: none;
}
.widget-volume slider:hover,
.widget-backlight slider:hover,
widget-volume slider:hover,
widget-backlight slider:hover {
    background: $(hex primary) !important;
    border-color: $(hex primary) !important;
}

/* DND toggle switch slider */
.widget-dnd > switch slider {
    background: $(hex on_surface) !important;
    border-radius: 50%;
}
.widget-dnd > switch:checked slider {
    background: $(hex on_primary) !important;
}
SWAYNC_OVERRIDE

# SwayNC — restart to clear the GTK widget style cache. Fully guarded:
# swaync-client hangs forever in a "Will wait for connection…" loop when no
# daemon is running, so only run it if swaync is up, and force a hard timeout
# regardless. A missing/masked systemd unit is a no-op. Any failure falls
# through so the theme switch never stalls.
if pgrep -x swaync >/dev/null 2>&1; then
  systemctl --user stop swaync.service 2>/dev/null || true
  sleep 0.1
  timeout 5 swaync-client -rs >/dev/null 2>&1 || true
  sleep 0.2
  systemctl --user start swaync.service 2>/dev/null || true
  sleep 0.3
fi
# Tmux live theme refresh — strip oh-my-tmux inline colors (one-time cleanup)
strip_inline_colors() {
  local opt="$1"
  local raw val clean
  raw=$(tmux showw -g "$opt" 2>/dev/null) || return 0
  val="${raw#* }"; val="${val%\"}"; val="${val#\"}"
  val="${val#*#\[}"; val="#[$val"
  local prev=""
  while [[ "$val" != "$prev" ]]; do
    prev="$val"; val="${val%\\}"; val="${val%\"}"
  done
  clean=$(echo "$val" | sed 's/#\[\(fg\|bg\|none\|default\)[^]]*\]//g')
  [[ "$clean" != "$val" ]] && tmux setw -g "$opt" "$clean" 2>/dev/null || true
}
strip_inline_colors window-status-format
strip_inline_colors window-status-current-format
CUR_SEP=$(tmux show -g window-status-separator 2>/dev/null)
if echo "$CUR_SEP" | grep -q '#\['; then
  tmux set -g window-status-separator " " 2>/dev/null || true
fi

# Tmux style options
tmux set -g status-style "fg=$(hex on_surface),bg=default" 2>/dev/null
tmux set -g status-left-style "fg=$(hex primary),bg=default" 2>/dev/null
tmux set -g status-right-style "fg=$(hex on_surface_variant),bg=default" 2>/dev/null
tmux setw -g window-status-style "fg=$(hex outline),bg=default" 2>/dev/null
tmux setw -g window-status-current-style "fg=$(hex on_primary),bg=$(hex primary)" 2>/dev/null
tmux set -g pane-border-style "fg=$(hex surface_container_high)" 2>/dev/null
tmux set -g pane-active-border-style "fg=$(hex primary)" 2>/dev/null
tmux set -g message-style "fg=$(hex on_surface),bg=default" 2>/dev/null
tmux set -g message-command-style "fg=$(hex on_surface),bg=default" 2>/dev/null
tmux set -g mode-style "fg=$(hex on_surface),bg=$(hex surface_container_high)" 2>/dev/null
tmux set -g display-panes-colour "$(hex outline)" 2>/dev/null
tmux set -g display-panes-active-colour "$(hex primary)" 2>/dev/null
tmux set -g clock-mode-colour "$(hex primary)" 2>/dev/null
tmux setw -g window-status-activity-style "fg=$(hex on_surface_variant),bg=default" 2>/dev/null
tmux setw -g window-status-bell-style "fg=$(hex error),bg=default" 2>/dev/null
tmux setw -g window-status-last-style "fg=$(hex primary),bg=default" 2>/dev/null
tmux set -g window-status-separator " " 2>/dev/null
sleep 0.1
# Cycle theme to trigger GTK3 live reload (theme CSS IS reloaded on gsettings change)
gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita' 2>/dev/null || true
sleep 1
gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dank' 2>/dev/null || true
# Restart GTK portal so GTK4 file chooser dialogs pick up the refreshed CSS
systemctl --user restart xdg-desktop-portal-gtk.service 2>/dev/null || true
sleep 0.5
notify-send -i "$RANDOM_WP" "Theme Switcher" "Switched to $SELECTED"
