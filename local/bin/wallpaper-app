# ---------------------------------------------------------------------------
# Thumbnail cache
# ---------------------------------------------------------------------------


def get_cache_key(path: str) -> str:
    return hashlib.md5(os.path.abspath(path).encode()).hexdigest()


def get_thumb_path(path: str) -> str:
    return os.path.join(CACHE_DIR, get_cache_key(path) + ".png")


def ensure_thumbnails(wall_dir, cache_dir, progress_callback=None):
    os.makedirs(cache_dir, exist_ok=True)

    files = []
    for entry in sorted(os.listdir(wall_dir)):
        full = os.path.join(wall_dir, entry)
        if os.path.isfile(full) and entry.lower().endswith(IMAGE_EXTS):
            files.append(full)

    results = []
    total = len(files)

    for idx, src in enumerate(files, start=1):
        fname = os.path.basename(src)
        dst = get_thumb_path(src)

        if os.path.isfile(dst):
            src_mtime = os.path.getmtime(src)
            dst_mtime = os.path.getmtime(dst)
            if dst_mtime >= src_mtime:
                results.append((dst, fname, src))
                if progress_callback:
                    progress_callback(idx, total)
                continue

        try:
            subprocess.run(
                [
                    "convert",
                    src,
                    "-thumbnail",
                    f"{THUMB_SIZE}x{THUMB_SIZE}^",
                    "-gravity",
                    "center",
                    "-extent",
                    f"{THUMB_SIZE}x{THUMB_SIZE}",
                    dst,
                ],
                capture_output=True,
                timeout=30,
            )
        except Exception as exc:
            print(f"wallpaper-app: failed to thumbnail {fname}: {exc}", file=sys.stderr)
            if progress_callback:
                progress_callback(idx, total)
            continue

        if os.path.isfile(dst):
            results.append((dst, fname, src))
        else:
            print(
                f"wallpaper-app: thumbnail not created for {fname} (corrupted?)",
                file=sys.stderr,
            )

        if progress_callback:
            progress_callback(idx, total)

    return results


# ---------------------------------------------------------------------------
# Shared CSS provider
# ---------------------------------------------------------------------------

_css_provider = None


def _ensure_css():
    global _css_provider
    if _css_provider is not None:
        return
    _css_provider = Gtk.CssProvider()
    _css_provider.load_from_data(APP_CSS.encode())
    screen = Gdk.Screen.get_default()
    if screen:
        Gtk.StyleContext.add_provider_for_screen(
            screen, _css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )


# ---------------------------------------------------------------------------
# Single-instance lock
# ---------------------------------------------------------------------------


def acquire_lock() -> bool:
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    try:
        fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        with os.fdopen(fd, "w") as f:
            f.write(str(os.getpid()))
        return True
    except FileExistsError:
        return False


def release_lock():
    try:
        if os.path.isfile(LOCK_FILE):
            with open(LOCK_FILE) as f:
                pid_str = f.read().strip()
            if pid_str == str(os.getpid()):
                os.unlink(LOCK_FILE)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Image utilities
# ---------------------------------------------------------------------------


def load_pixbuf(path, max_w, max_h):
    """Load an image scaled to fit within max_w x max_h, preserving aspect."""
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(path, max_w, max_h)
        if pixbuf:
            return pixbuf
    except Exception:
        pass
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
        if pixbuf:
            w = pixbuf.get_width()
            h = pixbuf.get_height()
            scale = min(max_w / w, max_h / h, 1.0)
            new_w = max(int(w * scale), 1)
            new_h = max(int(h * scale), 1)
            return pixbuf.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)
    except Exception:
        pass
    return None


def get_image_resolution(path):
    """Return 'WxH' string or empty string on failure."""
    try:
        result = subprocess.run(
            ["identify", "-format", "%wx%h", path],
            capture_output=True,
            timeout=10,
        )
        if result.returncode == 0:
            return result.stdout.decode().strip()
    except Exception:
        pass
    return ""


# ---------------------------------------------------------------------------
# Preview popup
# ---------------------------------------------------------------------------


class PreviewWindow(Gtk.Window):
    """Modal preview overlay for a wallpaper."""

    def __init__(self, parent, full_path, filename, on_apply):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_transient_for(parent)
        self.set_attached_to(parent)
        self.set_title(f"Preview — {filename}")
        self.set_modal(True)
        self.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        self.set_default_size(PREVIEW_WIDTH, PREVIEW_HEIGHT)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_decorated(True)
        self.full_path = full_path
        self.on_apply = on_apply

        self.set_border_width(0)
        self.get_style_context().add_class("preview-window")

        self.connect("key-press-event", self._on_key)
        self.connect("destroy", self._on_destroy)

        self._build_ui(full_path, filename)
        self.show_all()
        self.present()  # Force focus on Wayland

    def _build_ui(self, full_path, filename):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.set_margin_start(16)
        vbox.set_margin_end(16)
        vbox.set_margin_top(16)
        vbox.set_margin_bottom(16)
        self.add(vbox)

        # Image area
        img_max_w = PREVIEW_WIDTH - 32
        img_max_h = PREVIEW_HEIGHT - 170
        pixbuf = load_pixbuf(full_path, img_max_w, img_max_h)
        if pixbuf:
            image = Gtk.Image.new_from_pixbuf(pixbuf)
        else:
            image = Gtk.Image.new_from_icon_name(
                "image-x-generic", Gtk.IconSize.DIALOG
            )
        image.get_style_context().add_class("preview-image")
        image.set_halign(Gtk.Align.CENTER)
        image.set_valign(Gtk.Align.CENTER)
        vbox.pack_start(image, expand=True, fill=True, padding=0)

        # Gap
        vbox.pack_start(Gtk.Box(), expand=False, fill=False, padding=10)

        # Separator
        sep = Gtk.HSeparator()
        sep.get_style_context().add_class("preview-separator")
        vbox.pack_start(sep, expand=False, fill=False, padding=0)

        # Gap
        vbox.pack_start(Gtk.Box(), expand=False, fill=False, padding=10)

        # Info row: filename | resolution
        info_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        info_box.set_halign(Gtk.Align.CENTER)

        fname_label = Gtk.Label(label=filename)
        fname_label.get_style_context().add_class("preview-filename")
        info_box.pack_start(fname_label, expand=False, fill=False, padding=0)

        res_text = get_image_resolution(full_path)
        if res_text:
            dot = Gtk.Label(label="·")
            dot.get_style_context().add_class("preview-resolution")
            info_box.pack_start(dot, expand=False, fill=False, padding=4)
            res_label = Gtk.Label(label=res_text)
            res_label.get_style_context().add_class("preview-resolution")
            info_box.pack_start(res_label, expand=False, fill=False, padding=0)

        vbox.pack_start(info_box, expand=False, fill=False, padding=0)

        # Path
        path_label = Gtk.Label(label=full_path)
        path_label.get_style_context().add_class("preview-path")
        path_label.set_halign(Gtk.Align.CENTER)
        path_label.set_ellipsize(True)
        vbox.pack_start(path_label, expand=False, fill=False, padding=2)

        # Gap
        vbox.pack_start(Gtk.Box(), expand=False, fill=False, padding=8)

        # Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.CENTER)

        cancel_btn = Gtk.Button.new_with_label("Cancel")
        cancel_btn.get_style_context().add_class("preview-cancel")
        cancel_btn.connect("clicked", lambda _: self.destroy())
        btn_box.pack_start(cancel_btn, expand=False, fill=False, padding=0)

        apply_btn = Gtk.Button.new_with_label("Set Wallpaper")
        apply_btn.get_style_context().add_class("preview-apply")
        apply_btn.grab_default()
        apply_btn.connect("clicked", lambda _: self._do_apply())
        btn_box.pack_start(apply_btn, expand=False, fill=False, padding=0)

        vbox.pack_start(btn_box, expand=False, fill=False, padding=0)

    def _do_apply(self):
        self.on_apply(self.full_path)
        self.destroy()

    def _on_key(self, widget, event):
        if event.keyval == 0xFF1B:  # Escape
            self.destroy()
            return True
        if event.keyval == 0xFF0D:  # Enter
            self._do_apply()
            return True
        return False

    def _on_destroy(self, *args):
        pass


# ---------------------------------------------------------------------------
# GTK Application
# ---------------------------------------------------------------------------


class WallpaperApp(Gtk.Window):
    """Main wallpaper-selector window."""

    def __init__(self):
        super().__init__()

        self.set_title("Wallpaper Selector")
        self.set_default_size(WINDOW_WIDTH, WINDOW_HEIGHT)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.set_border_width(0)

        self.connect("key-press-event", self.on_key_press)
        signal.signal(signal.SIGINT, self._handle_sigint)

        self.wallpapers = []
        self.generating = False
        self.selected_child = None
        self._preview = None
        self._nm_counter = 0
        self._nm_css_rules = []

        _ensure_css()
        self._build_ui()

    def _handle_sigint(self, signum, frame):
        Gtk.main_quit()

    # -- UI construction ----------------------------------------------------

    def _build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        vbox.set_margin_start(14)
        vbox.set_margin_end(14)
        vbox.set_margin_top(14)
        vbox.set_margin_bottom(14)
        self.add(vbox)

        # Header row
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        header_box.set_halign(Gtk.Align.FILL)

        self.header_label = Gtk.Label(label="Wallpaper Selector")
        self.header_label.get_style_context().add_class("header-label")
        self.header_label.set_halign(Gtk.Align.START)
        header_box.pack_start(self.header_label, expand=True, fill=True, padding=0)

        key_hint = Gtk.Label(label="← → navigate  ·  ↵ preview  ·  Esc quit")
        key_hint.get_style_context().add_class("key-hint")
        key_hint.set_halign(Gtk.Align.END)
        header_box.pack_end(key_hint, expand=False, fill=False, padding=0)

        vbox.pack_start(header_box, expand=False, fill=False, padding=0)

        # Separator
        separator = Gtk.HSeparator()
        separator.get_style_context().add_class("separator")
        vbox.pack_start(separator, expand=False, fill=False, padding=0)

        # Scrolled window with horizontal box
        self.scrolled_window = Gtk.ScrolledWindow()
        self.scrolled_window.set_policy(
            Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER
        )
        self.scrolled_window.set_shadow_type(Gtk.ShadowType.NONE)
        vbox.pack_start(self.scrolled_window, expand=True, fill=True, padding=0)

        self.hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.hbox.set_margin_top(4)
        self.hbox.set_margin_bottom(4)
        self.scrolled_window.add(self.hbox)

        # Status bar
        self.status_label = Gtk.Label(label="")
        self.status_label.get_style_context().add_class("status-label")
        self.status_label.set_no_show_all(True)
        vbox.pack_start(self.status_label, expand=False, fill=False, padding=2)

    # -- Loading wallpapers -------------------------------------------------

    def load_wallpapers(self):
        if not os.path.isdir(WALL_DIR):
            self.show_error(
                "Directory Not Found",
                f"Wallpaper directory not found:\n{WALL_DIR}\n\n"
                f"Please create the directory and add wallpaper images.",
            )
            sys.exit(1)

        has_images = any(
            f.lower().endswith(IMAGE_EXTS)
            for f in os.listdir(WALL_DIR)
            if os.path.isfile(os.path.join(WALL_DIR, f))
        )
        if not has_images:
            self.show_error(
                "No Wallpapers",
                f"No wallpapers found in:\n{WALL_DIR}\n\n"
                f"Add image files ({', '.join(IMAGE_EXTS)}) to that directory.",
            )
            sys.exit(1)

        daemon_running = (
            subprocess.run(
                ["pgrep", "-x", "awww-daemon"],
                capture_output=True,
            ).returncode
            == 0
        )
        if not daemon_running:
            print(
                "wallpaper-app: warning — awww-daemon is not running",
                file=sys.stderr,
            )

        self.generating = True

        def progress_callback(current, total):
            GLib.idle_add(self._update_progress, current, total)

        def generation_done(result):
            self.wallpapers = result
            self.generating = False
            GLib.idle_add(self._populate_wallpapers)

        from threading import Thread

        t = Thread(
            target=lambda: generation_done(
                ensure_thumbnails(WALL_DIR, CACHE_DIR, progress_callback)
            ),
            daemon=True,
        )
        t.start()

    def _update_progress(self, current, total):
        self.status_label.set_no_show_all(False)
        self.status_label.show()
        self.status_label.set_text(f"Generating thumbnails…  {current}/{total}")
        while Gtk.events_pending():
            Gtk.main_iteration()

    def _populate_wallpapers(self):
        self.status_label.set_no_show_all(True)
        self.status_label.hide()

        for child in self.hbox.get_children():
            self.hbox.remove(child)

        for thumb_path, fname, full_path in self.wallpapers:
            child = self._make_child(thumb_path, fname, full_path)
            self.hbox.pack_start(child, expand=False, fill=False, padding=0)

        if self._nm_css_rules:
            nm_provider = Gtk.CssProvider()
            nm_provider.load_from_data("\n".join(self._nm_css_rules).encode())
            Gtk.StyleContext.add_provider_for_screen(
                self.get_screen(),
                nm_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1,
            )

        count = len(self.wallpapers)
        self.header_label.set_text(f"Wallpaper Selector  —  {count} wallpapers")

        self.show_all()

        if not self.wallpapers:
            self.show_error(
                "No Wallpapers",
                "No usable wallpapers found.\n"
                "Check that ImageMagick (convert) is installed and images are valid.",
            )
            sys.exit(1)

        # Select current wallpaper by default
        current_wp = ""
        if os.path.isfile(LAST_WALLPAPER):
            try:
                with open(LAST_WALLPAPER) as f:
                    current_wp = f.read().strip()
            except Exception:
                pass

        children = self.hbox.get_children()
        selected = False
        if current_wp and children:
            for child in children:
                if getattr(child, "full_path", None) == current_wp:
                    self._select_child(child)
                    selected = True
                    break
        if not selected and children:
            self._select_child(children[0])

    def _make_child(self, thumb_path, fname, full_path):
        display_name = (fname[:18] + "\N{HORIZONTAL ELLIPSIS}") if len(fname) > 20 else fname

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_homogeneous(False)

        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(
                thumb_path, THUMB_SIZE, THUMB_SIZE
            )
            image = Gtk.Image.new_from_pixbuf(pixbuf)
        except Exception:
            image = Gtk.Image.new_from_icon_name(
                "image-x-generic", Gtk.IconSize.DIALOG
            )
        image.get_style_context().add_class("thumb-image")
        box.pack_start(image, expand=True, fill=True, padding=0)

        label = Gtk.Label(label=display_name)
        label.set_max_width_chars(18)
        label.set_ellipsize(True)
        label.set_xalign(0.5)
        label.get_style_context().add_class("child-label")
        box.pack_start(label, expand=False, fill=False, padding=2)

        child = Gtk.EventBox()
        child.add(box)
        child.get_style_context().add_class("wallpaper-child")
        child.full_path = full_path
        child.filename = fname
        child.connect("button-press-event", self.on_child_clicked)

        return child

    # -- Actions ------------------------------------------------------------

    def on_wallpaper_activated(self, full_path):
        """Apply the selected wallpaper."""
        if not full_path or not os.path.isfile(full_path):
            self.show_error("Error", "Selected wallpaper file not found.")
            return

        fname = os.path.basename(full_path)

        try:
            subprocess.run(
                ["notify-send", "-t", "1500", "Wallpaper", f"Setting: {fname}"],
                capture_output=True,
                timeout=5,
            )
        except Exception:
            pass

        daemon_running = (
            subprocess.run(
                ["pgrep", "-x", "awww-daemon"],
                capture_output=True,
            ).returncode
            == 0
        )
        if not daemon_running:
            resp = self.show_yes_no(
                "Daemon Not Running",
                "awww-daemon is not running.\n\nStart it now and retry?",
            )
            if resp == Gtk.ResponseType.YES:
                try:
                    subprocess.Popen(
                        ["awww-daemon"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                    time.sleep(0.3)
                    daemon_running = (
                        subprocess.run(
                            ["pgrep", "-x", "awww-daemon"],
                            capture_output=True,
                        ).returncode
                        == 0
                    )
                    if not daemon_running:
                        self.show_error(
                            "Error",
                            "Failed to start awww-daemon.\n"
                            "Please start it manually and try again.",
                        )
                        return
                except Exception as exc:
                    self.show_error("Error", f"Failed to start awww-daemon:\n{exc}")
                    return
            else:
                return

        try:
            result = subprocess.run(
                [*AWWW_ARGS, full_path],
                capture_output=True,
                timeout=30,
            )
            if result.returncode != 0:
                err = result.stderr.decode().strip() or "unknown error"
                self.show_error("awww Error", f"Failed to set wallpaper:\n{err}")
                return
        except Exception as exc:
            self.show_error("Error", f"Failed to run awww:\n{exc}")
            return

        try:
            os.makedirs(os.path.dirname(LAST_FILE), exist_ok=True)
            with open(LAST_FILE, "w") as f:
                f.write(full_path + "\n")
        except Exception as exc:
            print(f"wallpaper-app: failed to write last file: {exc}", file=sys.stderr)

        try:
            os.makedirs(THEME_CACHE_DIR, exist_ok=True)
            with open(LAST_WALLPAPER, "w") as f:
                f.write(full_path + "\n")
        except Exception as exc:
            print(
                f"wallpaper-app: failed to write last_wallpaper: {exc}",
                file=sys.stderr,
            )

        if os.path.isfile(CURRENT_THEME_FILE):
            try:
                with open(CURRENT_THEME_FILE) as f:
                    current_theme = f.read().strip()
            except Exception:
                current_theme = ""
            if current_theme == "Dynamic":
                wp_script = os.path.expanduser(
                    "~/.config/hypr/scripts/wallpaper-to-theme.sh"
                )
                threading.Thread(
                    target=lambda: subprocess.run(
                        [wp_script], capture_output=True, timeout=30
                    ),
                    daemon=True,
                ).start()

        Gtk.main_quit()

    # -- Selection helpers --------------------------------------------------

    def _select_child(self, child):
        if self.selected_child:
            self.selected_child.get_style_context().remove_class("selected")
        self.selected_child = child
        child.get_style_context().add_class("selected")
        child.grab_focus()

        hadj = self.scrolled_window.get_hadjustment()
        if hadj:
            alloc = child.get_allocation()
            page_size = hadj.get_page_size()
            target = alloc.x + alloc.width / 2 - page_size / 2
            target = max(0, min(target, hadj.get_upper() - page_size))
            hadj.set_value(target)

    def _open_preview(self, child):
        """Open the preview popup for *child*."""
        full_path = getattr(child, "full_path", None)
        filename = getattr(
            child, "filename", os.path.basename(full_path or "")
        )

        if not full_path or not os.path.isfile(full_path):
            self.show_error("Error", "Wallpaper file not found.")
            return

        # Destroy existing preview if any
        if self._preview is not None:
            try:
                self._preview.destroy()
            except Exception:
                pass

        self._preview = PreviewWindow(
            self,
            full_path,
            filename,
            on_apply=self.on_wallpaper_activated,
        )

    def on_child_clicked(self, child, event):
        """Click selects + opens preview popup."""
        self._select_child(child)
        self._open_preview(child)
        return True

    # -- Keyboard -----------------------------------------------------------

    def on_key_press(self, widget, event):
        if event.keyval == 0xFF1B:  # Escape
            Gtk.main_quit()
            return True

        children = self.hbox.get_children()
        if not children:
            return False

        current_idx = 0
        if self.selected_child and self.selected_child in children:
            current_idx = children.index(self.selected_child)

        if event.keyval == 0xFF53:  # Right arrow
            next_idx = min(current_idx + 1, len(children) - 1)
            self._select_child(children[next_idx])
            return True

        if event.keyval == 0xFF51:  # Left arrow
            prev_idx = max(current_idx - 1, 0)
            self._select_child(children[prev_idx])
            return True

        if event.keyval == 0xFF0D:  # Enter
            if self.selected_child:
                self._open_preview(self.selected_child)
            return True

        return False

    # -- Dialogs ------------------------------------------------------------

    def show_error(self, title, message):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text=title,
        )
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()

    def show_yes_no(self, title, message):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text=title,
        )
        dialog.format_secondary_text(message)
        resp = dialog.run()
        dialog.destroy()
        return resp


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    if not acquire_lock():
        try:
            subprocess.run(
                [
                    "notify-send",
                    "-t",
                    "2000",
                    "Wallpaper Selector",
                    "Already running",
                ],
                capture_output=True,
                timeout=5,
            )
        except Exception:
            pass
        sys.exit(0)

    app = WallpaperApp()
    app.load_wallpapers()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    try:
        Gtk.main()
    finally:
        release_lock()
